filters:
  and:
    - file.ext == "md"
formulas:
  Slug: |
    (
      if(file.folder == "posts", "/posts/" + file.name.replace(".md", ""),
        if(file.folder == "pages", "/pages/" + file.name.replace(".md", ""),
          if(file.folder == "projects", "/projects/" + file.name.replace(".md", ""),
            if(file.folder == "docs", "/docs/" + file.name.replace(".md", ""),
              ("/" + file.folder + "/" + file.name.replace(".md", "")).replace("/pages/index", "/").replace("/pages/", "/").replace("/special/index", "/").replace("/special/", "/").replace("/home", "/").replace("/index", "")
            )
          )
        )
      ) + "/"
    ).replace("//", "/")
  Content Folder: |-
    if(file.name == "index",
      if(file.folder != "",
        if(file.folder.replace("/" + file.folder.replace(/.*\//, ""), "") != "",
          file.folder.replace("/" + file.folder.replace(/.*\//, ""), ""),
          file.folder
        ),
        "root"
      ),
      if(file.folder != "",
        file.folder,
        "root"
      )
    )
properties:
  note.title:
    displayName: Title
  note.date:
    displayName: Date
  note.pubDate:
    displayName: Date
  formula.Slug:
    displayName: Path
  note.environment:
    displayName: Environment
views:
  - type: cms
    name: Posts
    filters:
      and:
        - file.folder.startsWith("posts")
    order:
      - file.name
      - title
      - description
      - date
      - image
      - imageAlt
      - featured
      - hideTOC
      - tags
      - environment
      - noIndex
      - aliases
    sort:
      - property: date
        direction: DESC
    imageProperty: note.image
    fallbackToEmbeds: if-empty
    propertyDisplay1: formula.Slug
    propertyDisplay2: note.environment
    showTextPreview: true
    imageFormat: cover
    showDate: true
    showDraftStatus: true
    propertyLabels: above
    titleProperty: note.title
    dateProperty: note.date
    draftStatusProperty: note.draft
    descriptionProperty: note.description
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: true
    tagsProperty: note.tags
    customizeNewButton: true
    newNoteLocation: posts
    cardSize: 250
    imageAspectRatio: 0.55
    maxTagsToShow: 3
    dateIncludeTime: false
    fallbackToContent: true
    draftStatusReverse: false
    scheduledDateProperty: note.date
    showScheduledBadge: true
  - type: cms
    name: Pages
    filters:
      and:
        - file.folder.startsWith("pages")
    sort:
      - property: title
        direction: ASC
    imageProperty: note.image
    fallbackToEmbeds: true
    showTextPreview: true
    imageFormat: cover
    showDate: true
    showDraftStatus: true
    propertyLabels: above
    titleProperty: note.title
    dateProperty: note.date
    draftStatusProperty: note.draft
    descriptionProperty: note.description
    propertyDisplay2: note.environment
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: true
    tagsProperty: note.tags
    customizeNewButton: true
    newNoteLocation: pages
    cardSize: 250
    imageAspectRatio: 0.55
  - type: cms
    name: Projects
    filters:
      and:
        - file.folder.startsWith("projects")
    sort:
      - property: title
        direction: ASC
    imageProperty: note.image
    fallbackToEmbeds: true
    propertyDisplay1: formula.Slug
    propertyDisplay2: note.environment
    showTextPreview: true
    imageFormat: cover
    showDate: true
    showDraftStatus: true
    propertyLabels: above
    titleProperty: note.title
    dateProperty: note.date
    draftStatusProperty: note.draft
    descriptionProperty: note.description
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: true
    tagsProperty: note.tags
    customizeNewButton: true
    newNoteLocation: projects
    cardSize: 250
    imageAspectRatio: 0.55
    maxTagsToShow: 3
  - type: cms
    name: Documentation
    filters:
      and:
        - file.folder.startsWith("docs")
    groupBy:
      property: category
      direction: ASC
    sort:
      - property: order
        direction: ASC
    imageProperty: note.image
    fallbackToEmbeds: true
    propertyDisplay1: formula.Slug
    propertyDisplay2: note.environment
    showTextPreview: true
    imageFormat: cover
    showDate: true
    showDraftStatus: true
    propertyLabels: above
    titleProperty: note.title
    dateProperty: note.lastModified
    draftStatusProperty: note.draft
    descriptionProperty: note.description
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: true
    tagsProperty: note.tags
    customizeNewButton: true
    newNoteLocation: docs
    cardSize: 250
    imageAspectRatio: 0.55
    maxTagsToShow: 3
